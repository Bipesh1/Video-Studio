      "lines": [
        {
          "id": "l07",
          "speaker": "narrator",
          "text": "The straw in the drink beside you shows why.",
          "pauseAfterMs": 500
        },
        {
          "id": "l08",
          "speaker": "narrator",
          "text": "The straw looks snapped because light changes direction when it crosses from water into air.",
          "pauseAfterMs": 600
        },
        {
          "id": "l09",
          "speaker": "narrator",
          "text": "Air bends light too, because air gets *thicker* the closer it is to the ground.",
          "pauseAfterMs": 600
        },
        {
          "id": "l10",
          "speaker": "narrator",
          "text": "So sunlight curves a little as it passes down through each layer.",
          "pauseAfterMs": 500
        },
        {
          "id": "l11",
          "speaker": "narrator",
          "text": "A high Sun's light comes almost straight down, so it barely bends.",
          "pauseAfterMs": 500
        },
        {
          "id": "l12",
          "speaker": "narrator",
          "text": "But a low Sun's light skims sideways through the thickest air, so it bends the *most*.",
          "pauseAfterMs": 1100
        }
      ],
