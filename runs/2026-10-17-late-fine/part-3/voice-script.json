      "voice": "am_onyx",
      "blend": [
        {
          "voice": "am_onyx",
          "weight": 0.7
        },
        {
          "voice": "am_michael",
          "weight": 0.3
        }
      ],
      "text": "When the fine was dropped, late pickups stayed just as *high.*",
      "engine": "chatterbox",
      "sample": "voices/samples/trainer.wav",
      "speed": 0.97,
      "pauseAfterMs": 402
    },
    {
      "id": "l24",
      "speaker": "trainer",
      "voice": "am_onyx",
      "blend": [
        {
          "voice": "am_onyx",
          "weight": 0.7
        },
        {
          "voice": "am_michael",
          "weight": 0.3
        }
      ],
      "text": "Now being late cost no money and no *sorry.*",
      "engine": "chatterbox",
      "sample": "voices/samples/trainer.wav",
      "speed": 0.97,
      "pauseAfterMs": 603
    },
    {
      "id": "l25",
