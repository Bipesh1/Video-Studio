          "voice": "am_onyx",
          "weight": 0.7
        },
        {
          "voice": "am_michael",
          "weight": 0.3
        }
      ],
      "text": "This is not a story. In 1998, two economists tried this at six *daycares* in Israel.",
      "engine": "chatterbox",
      "sample": "voices/samples/trainer.wav",
      "speed": 0.94,
      "pauseAfterMs": 402
    },
    {
      "id": "l22",
