        {
          "voice": "am_onyx",
          "weight": 0.7
        },
        {
          "voice": "am_michael",
          "weight": 0.3
        }
      ],
      "text": "The fine went to the owner. The teacher who waited got *nothing.*",
      "engine": "chatterbox",
      "sample": "voices/samples/trainer.wav",
      "speed": 0.97,
      "pauseAfterMs": 938
