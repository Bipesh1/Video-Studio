          "weight": 0.7
        },
        {
          "voice": "am_michael",
          "weight": 0.3
        }
      ],
      "text": "And nobody says sorry for *buying* something.",
      "engine": "chatterbox",
      "sample": "voices/samples/trainer.wav",
