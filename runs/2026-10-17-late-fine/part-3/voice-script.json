          "weight": 0.7
        },
        {
          "voice": "am_michael",
          "weight": 0.3
        }
      ],
      "text": "You do this too. When a late fee is small, you just *pay* it.",
      "engine": "chatterbox",
      "sample": "voices/samples/trainer.wav",
      "speed": 0.97,
      "pauseAfterMs": 603
    },
    {
      "id": "l27",
      "speaker": "narrator",
      "voice": "af_nicole",
      "text": "If you make a rule, skip the *small* fine. Ask as a favor, or make the fine big.",
