      "voice": "am_onyx",
      "blend": [
        {
          "voice": "am_onyx",
          "weight": 0.7
        },
        {
          "voice": "am_michael",
          "weight": 0.3
        }
      ],
      "text": "Within a few weeks, late pickups there nearly *doubled.*",
      "engine": "chatterbox",
      "sample": "voices/samples/trainer.wav",
      "speed": 0.97,
      "pauseAfterMs": 670
    },
    {
      "id": "l23",
