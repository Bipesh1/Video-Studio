      "pauseAfterMs": 1300
    },
    {
      "id": "l13",
      "speaker": "narrator",
      "voice": "am_michael",
      "text": "So here's the catch: the feeling may be real, but the *picture* came later.",
      "engine": "chatterbox",
      "sample": "voices/samples/catch-narrator.wav",
      "speed": 0.86,
      "pauseAfterMs": 1300
    },
    {
      "id": "l14",
      "speaker": "narrator",
      "voice": "am_michael",
      "text": "Researchers think it was stitched together from family *photos* and stories told at dinner.",
      "engine": "chatterbox",
