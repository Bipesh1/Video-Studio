      "lines": [
        {
          "id": "n16",
          "speaker": "narrator",
          "text": "Now he has nothing left to lose.",
          "speed": 0.92
        },
        {
          "id": "n17",
          "speaker": "narrator",
          "text": "A free Black friend, James Smith, helps him plan.",
          "speed": 0.92
        },
        {
          "id": "n18",
          "speaker": "narrator",
          "text": "A white shoemaker, Samuel Smith, agrees to ship him north for *eighty-six dollars,* more than half of all Henry has saved.",
          "speed": 0.92
        },
        {
          "id": "n19",
          "speaker": "narrator",
          "text": "To get a day off work, he burns his own hand with acid, *down to the bone.*",
          "speed": 0.92,
          "pauseAfterMs": 700
        },
        {
          "id": "n20",
          "speaker": "narrator",
          "text": "The box is about three feet across.",
          "speed": 0.92
        },
        {
          "id": "n21",
          "speaker": "narrator",
          "text": "Inside go a bladder of water and three small air holes.",
          "speed": 0.92
        },
        {
          "id": "n22",
          "speaker": "narrator",
          "text": "On the lid: *This side up.*",
          "speed": 0.92,
          "pauseAfterMs": 900
        },
        {
          "id": "n23",
          "speaker": "narrator",
          "text": "March, eighteen forty-nine.",
          "speed": 0.92
        },
        {
          "id": "n24",
          "speaker": "narrator",
          "text": "A wagon, a train, a steamboat, a ferry, another wagon.",
          "speed": 0.92
        },
        {
          "id": "n25",
          "speaker": "narrator",
          "text": "The express men handle the box *like freight,* because that is what they think it is.",
          "speed": 0.92
        },
        {
          "id": "n26",
          "speaker": "narrator",
          "text": "For nearly an hour and a half, he rides *on his head.*",
          "speed": 0.92
        },
        {
          "id": "n27",
          "speaker": "narrator",
          "text": "*Twenty-seven hours,* and he never cries out.",
          "speed": 0.92,
          "pauseAfterMs": 1000
        }
      ],
