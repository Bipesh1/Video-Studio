      "lines": [
        {
          "id": "l16",
          "speaker": "narrator",
          "text": "Melissa Ilardo's team published this in the journal *Cell* in 2018.",
          "pauseAfterMs": 500
        },
        {
          "id": "l17",
          "speaker": "narrator",
          "text": "They also found a gene, PDE10A, that may make the spleen *bigger*.",
          "pauseAfterMs": 500
        },
        {
          "id": "l18",
          "speaker": "narrator",
          "text": "Scientists think it works through a body hormone, but nobody has *proved* that yet.",
          "pauseAfterMs": 500
        },
        {
          "id": "l19",
          "speaker": "narrator",
          "text": "The breath hold world record is twenty nine minutes, but only after breathing pure *oxygen*.",
