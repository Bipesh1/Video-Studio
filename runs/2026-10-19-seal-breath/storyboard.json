      "lines": [
        {
          "id": "l05",
          "speaker": "narrator",
          "text": "While you hold your breath, the oxygen in your blood slowly *runs down*.",
          "pauseAfterMs": 500
        },
        {
          "id": "l06",
          "speaker": "narrator",
          "text": "So your body switches on its dive reflex: your heart slows, and blood leaves your hands and *feet*.",
          "pauseAfterMs": 500
        },
        {
          "id": "l07",
          "speaker": "narrator",
          "text": "Then your spleen, a small organ under your ribs, squeezes like a *sponge*.",
          "pauseAfterMs": 500
        },
        {
          "id": "l08",
          "speaker": "narrator",
          "text": "It pushes spare red blood cells, which carry oxygen, into your blood like a *backup tank*.",
          "pauseAfterMs": 500
        },
        {
          "id": "l09",
          "speaker": "narrator",
          "text": "Seals have enormous spleens for exactly this *reason*.",
          "pauseAfterMs": 1100
