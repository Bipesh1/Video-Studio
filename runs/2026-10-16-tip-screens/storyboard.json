        },
        {
          "id": "l06",
          "speaker": "narrator",
          "text": "It offers you a tip of twenty, twenty five or *thirty* percent.",
          "pauseAfterMs": 500
        },
        {
          "id": "l07",
          "speaker": "narrator",
          "text": "Most of us assume those buttons are simply the *normal* amounts.",
