      "lines": [
        {
          "id": "l16",
          "speaker": "narrator",
          "text": "Two scientists in Australia worked this out by tracking every *atom* in ten kilos of fat.",
          "pauseAfterMs": 400
        },
        {
          "id": "l17",
          "speaker": "narrator",
          "text": "Ten kilos of fat plus twenty nine kilos of oxygen went *in*.",
          "pauseAfterMs": 400
        },
        {
          "id": "l18",
          "speaker": "narrator",
          "text": "Twenty eight kilos of carbon dioxide and eleven kilos of water came *out*.",
          "pauseAfterMs": 400
        },
        {
          "id": "l19",
          "speaker": "narrator",
          "text": "Both sides weigh thirty nine kilos, so not a single atom went *missing*.",
          "pauseAfterMs": 700
        },
        {
          "id": "l20",
          "speaker": "narrator",
          "text": "And no, panting on the sofa will not burn more fat. You will just get *dizzy*.",
          "pauseAfterMs": 800
        }
      ],
