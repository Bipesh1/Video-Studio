{
  "name": "video-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A local application that Claude operates to turn a script or idea into a narrated Ink Stick cartoon video.",
  "type": "module",
  "workspaces": [
    "shared",
    "engine",
    "cli"
  ],
  "scripts": {
    "doctor": "tsx cli/src/doctor.ts",
    "bench": "tsx cli/src/bench.ts",
    "sheets": "tsx cli/src/sheets.ts",
    "look-test": "tsx cli/src/look-test.ts",
    "test": "vitest run",
    "typecheck": "tsc -p shared/tsconfig.json && tsc -p engine/tsconfig.json && tsc -p cli/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
